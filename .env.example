# CortexOT — Industrial AI Advisor (Phase 0)

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / TimescaleDB (cortexot-timescaledb)
POSTGRES_USER=cortexot
POSTGRES_PASSWORD=cortexot
POSTGRES_DB=cortexot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cortexot:cortexot@localhost:5432/cortexot

# Ollama (cortexot-ollama)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Service ports (host)
BACKEND_PORT=8000
MCP_PORT=8001
SIMULATOR_HTTP_PORT=8080

# Internal service URLs (used by cortexot-backend in Docker)
MCP_BASE_URL=http://localhost:8001
SIMULATOR_BASE_URL=http://localhost:8080
